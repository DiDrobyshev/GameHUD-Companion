{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameHUD Tactical Companion",
  "version": "0.9.7",
  "identifier": "com.ddrob.game-notes-overlay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "GameHUD Tactical Companion",
        "width": 1020,
        "height": 720,
        "minWidth": 680,
        "minHeight": 480,
        "alwaysOnTop": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "skipTaskbar": false,
        "visible": true,
        "url": "index.html?window=main"
      },
      {
        "label": "timer-hud",
        "title": "GameHUD Timers",
        "width": 260,
        "height": 190,
        "resizable": false,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "url": "index.html?window=timer-hud"
      },
      {
        "label": "pip-hud",
        "title": "GameHUD PiP Player",
        "width": 460,
        "height": 290,
        "minWidth": 260,
        "minHeight": 180,
        "resizable": true,
        "alwaysOnTop": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "url": "index.html?window=pip-hud"
      },
      {
        "label": "snipper",
        "title": "GameHUD Snipper",
        "fullscreen": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "skipTaskbar": true,
        "url": "index.html?window=snipper"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
